  <!-- SECTION: Why Browser-Based Tools Matter (SEO) -->
  <section class="py-24 px-4 md:px-6 bg-canvas-soft border-b border-hairline">
    <div class="max-w-[800px] mx-auto reveal">
      <h2 class="text-display-md md:text-[36px] font-semibold tracking-[-1px] text-ink mb-10 text-center">Why Browser-Based Tools Matter</h2>
      
      <div class="space-y-8 text-body text-base leading-relaxed">
        <div class="space-y-3">
          <h3 class="text-body-lg font-semibold text-ink">Local Processing: The Ultimate Security Layer</h3>
          <p>
            Every time you upload an image to strip EXIF data or paste confidential financial records into an online calculator, you hand over custody of your files to third-party servers. Traditional software-as-a-service (SaaS) utility websites run heavy backend databases that log and store your uploads, exposing you to data leaks, server hacks, and unauthorized telemetry tracking. By moving processing entirely inside your local browser sandboxed engine, AutoAgenix ensures that your files never exit the physical boundaries of your client machine. 
          </p>
        </div>
        
        <div class="space-y-3">
          <h3 class="text-body-lg font-semibold text-ink">True Privacy by Design with Zero Telemetry</h3>
          <p>
            True privacy isn't just about showing a compliance banner or meeting minimum regulatory baselines. It is defined by the technical impossibility of intercepting data. AutoAgenix does not require user registration, emails, cookies, or background tracking pixels. All local file handling and calculation logic execute inside standard client APIs. You can inspect the source code, trace the browser network activity, or even run the utilities entirely offline. What is never sent to a database can never be breached.
          </p>
        </div>
        
        <div class="space-y-3">
          <h3 class="text-body-lg font-semibold text-ink">Sub-Second Local Execution Speeds</h3>
          <p>
            Traditional tools rely on network latency: uploading the file, waiting for a queue to process it, and downloading the result. When running operations client-side, execution occurs near-instantly at the hardware limits of your local CPU. By executing operations directly on-device using optimized client scripts and modern browser capabilities, we offer sub-second processing without waiting times or backend queues, while running on a highly optimized static site architecture.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 11: FINAL CTA -->
  <section class="py-32 md:py-48 px-4 md:px-6 relative overflow-hidden bg-primary text-on-primary">
    <!-- Atmospheric background -->
    <div class="absolute inset-0 mesh-gradient opacity-50 z-0 pointer-events-none"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,transparent_0%,var(--color-primary)_100%)] z-0 pointer-events-none"></div>
    
    <div class="max-w-4xl mx-auto text-center relative z-10 reveal">
      <h2 class="text-display-xl md:text-[72px] leading-[1.05] font-semibold tracking-[-2px] mb-6 text-balance">
        Stop Uploading <br class="hidden md:block"/> Sensitive Files.
      </h2>
      <p class="text-body-lg md:text-xl text-mute max-w-2xl mx-auto mb-12 text-balance font-medium">
        Use browser-based tools built with privacy in mind. Instant results. Zero tracking. No accounts.
      </p>
      <div class="flex justify-center">
        <a href="#search-tools" class="px-8 py-4 bg-canvas text-ink rounded-pill font-medium text-button-lg hover:bg-canvas-soft transition-all shadow-lg hover:scale-[1.02] active:scale-95">
          Explore Tools
        </a>
      </div>
    </div>
  </section>

  <!-- FINAL TRUST BAR -->
  <div class="w-full bg-[#0d0d0d] border-t border-[#1c1c1c] py-6 px-4 md:px-6 z-10 text-white select-none">
    <div class="max-w-[1400px] mx-auto flex flex-wrap justify-center items-center gap-x-8 gap-y-3 text-[10px] sm:text-xs font-mono uppercase tracking-widest text-[#a1a1a1]">
      <div class="flex items-center gap-1.5">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-emerald-400">
          <polyline points="20 6 9 17 4 12"/>
        </svg>
        No Uploads
      </div>
      <div class="flex items-center gap-1.5">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-emerald-400">
          <polyline points="20 6 9 17 4 12"/>
        </svg>
        No Sign Up
      </div>
      <div class="flex items-center gap-1.5">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-emerald-400">
          <polyline points="20 6 9 17 4 12"/>
        </svg>
        No Tracking
      </div>
      <div class="flex items-center gap-1.5">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-emerald-400">
          <polyline points="20 6 9 17 4 12"/>
        </svg>
        Browser Based
      </div>
      <div class="flex items-center gap-1.5">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-emerald-400">
          <polyline points="20 6 9 17 4 12"/>
        </svg>
        Free To Use
      </div>
    </div>
  </div>

</BaseLayout>

<script>
  // Intersection Observer for scroll reveal animations
  document.addEventListener('DOMContentLoaded', () => {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
        }
      });
    }, {
      threshold: 0.1,
      rootMargin: "0px 0px -50px 0px"
    });

    document.querySelectorAll('.reveal').forEach((el) => {
      observer.observe(el);
    });

    // ────────────────────────────────────────────────────────
    // Interactive Hero Demo Logic
    // ────────────────────────────────────────────────────────
    const demoDropzone = document.getElementById('demo-dropzone');
    const demoFileInput = document.getElementById('demo-file-input') as HTMLInputElement;
    const demoTryBtn = document.getElementById('demo-try-btn');
    const demoProcessing = document.getElementById('demo-processing');
    const demoSuccess = document.getElementById('demo-success');
    const demoReset = document.getElementById('demo-reset');
    const demoDownload = document.getElementById('demo-download') as HTMLAnchorElement;
    const demoProcessText = document.getElementById('demo-process-text');
    
    const log1 = document.getElementById('demo-log-1');
    const log2 = document.getElementById('demo-log-2');
    const log3 = document.getElementById('demo-log-3');
    const log4 = document.getElementById('demo-log-4');
    const log5 = document.getElementById('demo-log-5');
    
    const beforeSizeEl = document.getElementById('demo-before-size');
    const afterSizeEl = document.getElementById('demo-after-size');

    function resetDemo() {
      if (demoSuccess) demoSuccess.classList.add('hidden');
      if (demoProcessing) demoProcessing.classList.add('hidden');
      if (demoDropzone) demoDropzone.classList.remove('hidden');
      if (demoFileInput) demoFileInput.value = '';
      
      // Hide logs
      [log1, log2, log3, log4, log5].forEach(el => {
        if (el) el.classList.add('opacity-0');
      });
    }

    if (demoReset) demoReset.addEventListener('click', resetDemo);

    function simulateProcessing(fileName: string, fileSizeMb: number, realDataUrl?: string) {
      if (demoDropzone) demoDropzone.classList.add('hidden');
      if (demoProcessing) demoProcessing.classList.remove('hidden');
      if (demoProcessText) demoProcessText.textContent = "Processing image client-side...";

      // Simulated logs sequence
      setTimeout(() => {
        if (log1) {
          log1.textContent = `> File: ${fileName} (${fileSizeMb.toFixed(1)} MB)`;
          log1.classList.remove('opacity-0');
        }
      }, 200);

      setTimeout(() => {
        if (log2) log2.classList.remove('opacity-0');
      }, 500);

      setTimeout(() => {
        if (log3) log3.classList.remove('opacity-0');
      }, 800);

      setTimeout(() => {
        if (log4) log4.classList.remove('opacity-0');
      }, 1100);

      setTimeout(() => {
        if (log5) log5.classList.remove('opacity-0');
      }, 1400);

      setTimeout(() => {
        // Transition to success
        if (demoProcessing) demoProcessing.classList.add('hidden');
        if (demoSuccess) demoSuccess.classList.remove('hidden');
        
        // Update sizes in UI
        if (beforeSizeEl) beforeSizeEl.textContent = `${fileSizeMb.toFixed(1)} MB`;
        if (afterSizeEl) afterSizeEl.textContent = `${(fileSizeMb * 0.92).toFixed(1)} MB`;
        
        if (demoDownload) {
          if (realDataUrl) {
            demoDownload.href = realDataUrl;
            demoDownload.download = `cleaned-${fileName}`;
          } else {
            // Generate a sample sunset image on canvas
            const canvas = document.createElement('canvas');
            canvas.width = 800;
            canvas.height = 500;
            const ctx = canvas.getContext('2d');
            if (ctx) {
              const grad = ctx.createLinearGradient(0, 0, 0, 500);
              grad.addColorStop(0, '#7928ca'); // violet
              grad.addColorStop(0.5, '#ff0080'); // pink
              grad.addColorStop(1, '#f9cb28'); // amber
              ctx.fillStyle = grad;
              ctx.fillRect(0, 0, 800, 500);
              
              ctx.fillStyle = '#ffffff';
              ctx.font = 'bold 36px system-ui, sans-serif';
              ctx.textAlign = 'center';
              ctx.fillText('AutoAgenix Sunset Sample', 400, 220);
              ctx.font = '18px monospace';
              ctx.fillStyle = 'rgba(255,255,255,0.7)';
              ctx.fillText('EXIF METADATA STRIPPED • 100% PRIVATE', 400, 270);
            }
            demoDownload.href = canvas.toDataURL('image/jpeg', 0.9);
            demoDownload.download = 'autoagenix-cleaned-sample.jpg';
          }
        }
      }, 1800);
    }

    // Sample click
    if (demoTryBtn) {
      demoTryBtn.addEventListener('click', (e) => {
        e.stopPropagation(); // Avoid triggering file input
        simulateProcessing('sunset_in_sf.jpg', 4.2);
      });
    }

    // File selection
    if (demoFileInput) {
      demoFileInput.addEventListener('change', () => {
        if (demoFileInput.files && demoFileInput.files.length) {
          const file = demoFileInput.files[0];
          if (!file.type.match('image.*')) {
            alert('Please select a valid image file (JPEG, PNG, WebP).');
            return;
          }

          const reader = new FileReader();
          reader.onload = (e) => {
            const img = new Image();
            img.onload = () => {
              const canvas = document.createElement('canvas');
              canvas.width = img.width;
              canvas.height = img.height;
              const ctx = canvas.getContext('2d');
              if (ctx) {
                ctx.drawImage(img, 0, 0);
                const format = file.type === 'image/png' ? 'image/png' : 'image/jpeg';
                const cleanDataUrl = canvas.toDataURL(format, 0.95);
                const sizeInMb = file.size / (1024 * 1024);
                simulateProcessing(file.name, sizeInMb, cleanDataUrl);
              }
            };
            img.src = e.target?.result as string;
          };
          reader.readAsDataURL(file);
        }
      });
    }

    // ────────────────────────────────────────────────────────
    // Live Tool Search Logic
    // ────────────────────────────────────────────────────────
    const searchInput = document.getElementById('tool-search') as HTMLInputElement;
    const searchCards = document.querySelectorAll('.search-tool-card') as NodeListOf<HTMLDivElement>;
    const emptyState = document.getElementById('search-empty-state');
    const filterTabs = document.querySelectorAll('.search-filter-tab');
    
    let activeCategory = 'all';

    function filterTools() {
      const query = searchInput ? searchInput.value.toLowerCase().trim() : '';
      let matchesCount = 0;

      searchCards.forEach(card => {
        const name = card.dataset.name || '';
        const desc = card.dataset.description || '';
        const category = card.dataset.category || '';
        
        const matchesQuery = name.includes(query) || desc.includes(query);
        const matchesCategory = activeCategory === 'all' || category === activeCategory;

        if (matchesQuery && matchesCategory) {
          card.classList.remove('hidden');
          matchesCount++;
        } else {
          card.classList.add('hidden');
        }
      });

      if (matchesCount === 0) {
        if (emptyState) emptyState.classList.remove('hidden');
      } else {
        if (emptyState) emptyState.classList.add('hidden');
      }
    }

    if (searchInput) {
      searchInput.addEventListener('input', filterTools);
      
      // Keyboard shortcut (⌘K or / to focus search)
      window.addEventListener('keydown', (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
          e.preventDefault();
          searchInput.focus();
        }
        if (e.key === '/' && document.activeElement !== searchInput) {
          e.preventDefault();
          searchInput.focus();
          searchInput.select();
        }
      });
    }

    filterTabs.forEach(tab => {
      tab.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        
        // Update active styling
        filterTabs.forEach(t => {
          t.classList.remove('bg-primary', 'text-on-primary');
          t.classList.add('bg-canvas', 'text-body');
        });
        target.classList.remove('bg-canvas', 'text-body');
        target.classList.add('bg-primary', 'text-on-primary');
        
        activeCategory = target.dataset.category || 'all';
        filterTools();
      });
    });
  });
</script>
