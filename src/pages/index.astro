---
import BaseLayout from '../layouts/BaseLayout.astro';
import CategoryCard from '../components/CategoryCard.astro';
import ToolCard from '../components/ToolCard.astro';
import { categories, tools } from '../data/tools';

const featuredTools = tools.filter(t => t.featured).slice(0, 3);
---

<BaseLayout title="AutoAgenix | Privacy-First Online Tools">
  <!-- SECTION 2: HERO & LIVE DEMO -->
  <section class="relative pt-20 pb-20 md:pt-28 md:pb-28 px-4 md:px-6 overflow-hidden flex flex-col justify-center border-b border-hairline bg-canvas">
    <div class="absolute inset-0 mesh-gradient z-0 pointer-events-none"></div>
    <div class="absolute inset-0 grid-overlay opacity-[0.15] z-0 pointer-events-none"></div>
    
    <div class="relative z-10 max-w-[1200px] mx-auto w-full grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <!-- Left Column: Primary Positioning & Copy -->
      <div class="lg:col-span-7 flex flex-col items-center lg:items-start text-center lg:text-left animate-fade-up">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-canvas/60 backdrop-blur-md border border-hairline text-caption font-mono mb-8 text-body shadow-sm">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-500 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
          </span>
          <span>v1.0 is live</span>
          <span class="text-mute">•</span>
          <span class="text-ink font-semibold">{tools.length} Tools Available</span>
          <span class="text-mute">•</span>
          <span class="text-success font-medium animate-pulse-dot">Growing Platform</span>
        </div>
        
        <h1 class="text-display-xl md:text-[64px] lg:text-[76px] leading-[1.05] font-semibold tracking-[-2.4px] md:tracking-[-3px] text-ink mb-6 max-w-2xl text-balance">
          Your Files Never Leave Your Device.
        </h1>
        
        <p class="text-body-lg md:text-[20px] leading-relaxed text-body max-w-xl mb-10 text-balance font-medium">
          Process, clean, convert and protect files directly in your browser. 
          <span class="text-ink">Fast, secure and completely private.</span>
        </p>
        
        <div class="flex flex-col sm:flex-row gap-4 items-center justify-center lg:justify-start mb-10 w-full sm:w-auto">
          <a href="#search-tools" class="px-8 py-4 bg-primary text-on-primary rounded-pill font-medium text-button-lg hover:bg-ink/90 transition-all shadow-level-2 w-full sm:w-auto hover:scale-[1.02] active:scale-95 text-center">
            Explore Tools
          </a>
          <a href="#how-it-works" class="px-8 py-4 bg-canvas/80 backdrop-blur-sm text-ink rounded-pill font-medium text-button-lg border border-hairline hover:bg-canvas-soft transition-all shadow-level-1 w-full sm:w-auto hover:scale-[1.02] active:scale-95 text-center">
            How It Works
          </a>
        </div>

        <div class="grid grid-cols-2 gap-x-8 gap-y-3 text-sm font-medium text-body max-w-sm">
          <span class="trust-check">100% Browser Based</span>
          <span class="trust-check">No Sign Up Required</span>
          <span class="trust-check">Zero Tracking</span>
          <span class="trust-check">Free Forever</span>
        </div>
      </div>
      
      <!-- Right Column: Miniature Interactive Demo Mockup -->
      <div class="lg:col-span-5 w-full flex justify-center animate-fade-up delay-200">
        <div class="w-full max-w-md bg-[#0a0a0a] border border-[#232323] rounded-2xl shadow-level-4 overflow-hidden text-left text-[#f5f5f5] font-sans">
          <!-- Window Header -->
          <div class="flex items-center justify-between px-4 py-3 bg-[#121212] border-b border-[#232323] select-none">
            <div class="flex items-center gap-1.5">
              <span class="w-3 h-3 rounded-full bg-[#ff5f56]"></span>
              <span class="w-3 h-3 rounded-full bg-[#ffbd2e]"></span>
              <span class="w-3 h-3 rounded-full bg-[#27c93f]"></span>
            </div>
            <span class="text-xs font-mono text-[#737373]">exif-metadata-remover.sh</span>
            <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">Local Engine</span>
          </div>
          
          <!-- Window Content -->
          <div class="p-6">
            <!-- State 1: Dropzone -->
            <div id="demo-dropzone" class="border border-dashed border-[#333] rounded-xl p-8 text-center hover:bg-[#121212] transition-colors cursor-pointer relative group">
              <input type="file" id="demo-file-input" accept="image/jpeg, image/png, image/webp" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer" />
              <div class="space-y-4">
                <div class="w-12 h-12 bg-[#161616] border border-[#262626] rounded-full flex items-center justify-center mx-auto shadow-sm group-hover:scale-105 transition-transform duration-300">
                  <svg class="w-6 h-6 text-[#a1a1a1] group-hover:text-white transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
                  </svg>
                </div>
                <div>
                  <h3 class="text-sm font-semibold text-[#f5f5f5]">Upload an image</h3>
                  <p class="text-xs text-[#737373] mt-1">Drag and drop, or click to browse</p>
                </div>
                <div class="pt-2 flex flex-col gap-2 max-w-xs mx-auto">
                  <button type="button" id="demo-try-btn" class="w-full py-2 bg-white text-black rounded font-medium text-xs hover:bg-[#e6e6e6] transition-all">
                    Try Sample Image
                  </button>
                </div>
              </div>
            </div>
            
            <!-- State 2: Processing -->
            <div id="demo-processing" class="hidden space-y-4 py-4">
              <div class="flex items-center gap-3 text-sm text-[#a1a1a1]">
                <svg class="animate-spin h-4 w-4 text-white" fill="none" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
                <span id="demo-process-text">Processing image client-side...</span>
              </div>
              <div class="font-mono text-xs bg-[#121212] border border-[#232323] p-4 rounded-lg text-[#888] space-y-1 overflow-x-auto h-36">
                <div class="text-emerald-500">&gt; Initialize sandbox...</div>
                <div id="demo-log-1" class="opacity-0 transition-opacity duration-200">&gt; File: image.jpg (4.2 MB)</div>
                <div id="demo-log-2" class="opacity-0 transition-opacity duration-200 text-yellow-500">&gt; Metadata found: 14 EXIF fields</div>
                <div id="demo-log-3" class="opacity-0 transition-opacity duration-200">&gt; [EXIF] GPS: 37.7749° N, 122.4194° W</div>
                <div id="demo-log-4" class="opacity-0 transition-opacity duration-200">&gt; [EXIF] Device: Apple iPhone 15 Pro</div>
                <div id="demo-log-5" class="opacity-0 transition-opacity duration-200 text-cyan-400">&gt; Stripping headers... 100% clean</div>
              </div>
            </div>
            
            <!-- State 3: Success -->
            <div id="demo-success" class="hidden space-y-4">
              <div class="p-3 bg-emerald-500/10 border border-emerald-500/20 rounded-lg flex items-start gap-3 text-left">
                <svg class="w-5 h-5 text-emerald-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <div>
                  <h4 class="font-semibold text-sm text-emerald-400">Metadata Removed</h4>
                  <p class="text-xs text-[#a1a1a1] mt-0.5">EXIF headers, GPS, and camera markers were stripped from your image.</p>
                </div>
              </div>
              
              <div class="p-4 bg-[#121212] border border-[#232323] rounded-lg text-xs space-y-2.5 font-mono">
                <div class="flex justify-between border-b border-[#232323] pb-2 text-[#737373]">
                  <span>Property</span>
                  <span>Before</span>
                  <span>After</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-[#a1a1a1]">File Size</span>
                  <span id="demo-before-size">4.2 MB</span>
                  <span id="demo-after-size" class="text-emerald-400">3.9 MB</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-[#a1a1a1]">Camera EXIF</span>
                  <span class="text-red-400">iPhone 15 Pro</span>
                  <span class="text-emerald-400">None</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-[#a1a1a1]">GPS Coordinates</span>
                  <span class="text-red-400">37.7749° N</span>
                  <span class="text-emerald-400">None</span>
                </div>
              </div>
              
              <div class="flex flex-col gap-2">
                <a id="demo-download" href="#" download="cleaned-image.jpg" class="flex items-center justify-center gap-2 w-full py-3 bg-white text-black rounded-pill font-semibold text-sm hover:bg-[#e6e6e6] transition-all">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                  </svg>
                  Download Cleaned Image
                </a>
                <button id="demo-reset" class="w-full text-xs text-[#737373] hover:text-white transition-colors underline decoration-dotted py-2">
                  Clean Another Image
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 3: CORE VALUE PROPOSITIONS (REPLACED STATS) -->
  <section class="py-20 md:py-28 px-4 md:px-6 border-b border-hairline bg-canvas">
    <div class="max-w-[1400px] mx-auto reveal">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        <!-- Card 1 -->
        <div class="flex flex-col bg-canvas border border-hairline rounded-xl p-6 shadow-level-1 hover:border-hairline-strong transition-all duration-300">
          <div class="w-10 h-10 bg-canvas-soft border border-hairline rounded-lg flex items-center justify-center mb-5 text-ink shadow-sm">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
              <line x1="8" y1="21" x2="16" y2="21"/>
              <line x1="12" y1="17" x2="12" y2="21"/>
            </svg>
          </div>
          <h3 class="text-body-md-strong text-ink font-semibold mb-2">100% Browser Processing</h3>
          <p class="text-body-sm text-body leading-relaxed">Everything happens locally. Your files never touch our servers, removing upload latency entirely.</p>
        </div>

        <!-- Card 2 -->
        <div class="flex flex-col bg-canvas border border-hairline rounded-xl p-6 shadow-level-1 hover:border-hairline-strong transition-all duration-300">
          <div class="w-10 h-10 bg-canvas-soft border border-hairline rounded-lg flex items-center justify-center mb-5 text-ink shadow-sm">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
              <circle cx="9" cy="7" r="4"/>
              <line x1="19" y1="8" x2="19" y2="14"/>
              <line x1="22" y1="11" x2="16" y2="11"/>
            </svg>
          </div>
          <h3 class="text-body-md-strong text-ink font-semibold mb-2">No Sign Up Required</h3>
          <p class="text-body-sm text-body leading-relaxed">Open any tool and use it instantly. We collect no personal data, no emails, and no credit card info.</p>
        </div>

        <!-- Card 3 -->
        <div class="flex flex-col bg-canvas border border-hairline rounded-xl p-6 shadow-level-1 hover:border-hairline-strong transition-all duration-300">
          <div class="w-10 h-10 bg-canvas-soft border border-hairline rounded-lg flex items-center justify-center mb-5 text-ink shadow-sm">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
          </div>
          <h3 class="text-body-md-strong text-ink font-semibold mb-2">Zero Tracking</h3>
          <p class="text-body-sm text-body leading-relaxed">No tracking cookies, no analytics logs, no monitoring. Your work is entirely confidential and sandboxed.</p>
        </div>

        <!-- Card 4 -->
        <div class="flex flex-col bg-canvas border border-hairline rounded-xl p-6 shadow-level-1 hover:border-hairline-strong transition-all duration-300">
          <div class="w-10 h-10 bg-canvas-soft border border-hairline rounded-lg flex items-center justify-center mb-5 text-ink shadow-sm">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
            </svg>
          </div>
          <h3 class="text-body-md-strong text-ink font-semibold mb-2">Fast Results</h3>
          <p class="text-body-sm text-body leading-relaxed">Ditch the server queue. WebAssembly and client-side processing deliver instant computation on-device.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 4: FEATURED TOOLS -->
  <section id="featured-tools" class="py-24 md:py-32 px-4 md:px-6 bg-canvas-soft">
    <div class="max-w-[1400px] mx-auto reveal">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
        <div>
          <span class="font-mono text-xs uppercase tracking-widest text-mute mb-3 block">Spotlight</span>
          <h2 class="text-display-lg md:text-[48px] font-semibold tracking-[-1.5px] text-ink">Featured Tools</h2>
        </div>
        <a href="#search-tools" class="inline-flex items-center gap-2 text-body-sm font-medium hover:text-ink transition-colors pb-1 border-b border-transparent hover:border-ink">
          View all tools
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" class="transition-transform group-hover:translate-x-1">
            <path d="M2.91666 7H11.0833M11.0833 7L7.58332 3.5M11.0833 7L7.58332 10.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {featuredTools.map(tool => (
          <a href={tool.path} class="tool-card group block bg-canvas border border-hairline rounded-xl p-6 relative overflow-hidden transition-all duration-300 hover:-translate-y-1 hover:border-hairline-strong shadow-level-1 hover:shadow-level-3">
            <div class="absolute inset-0 bg-gradient-to-b from-canvas-soft to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
            <div class="relative z-10 flex flex-col h-full">
              <div class="flex items-center justify-between mb-6">
                <div class="w-12 h-12 rounded-lg bg-canvas-soft border border-hairline flex items-center justify-center shadow-sm group-hover:scale-105 transition-transform duration-300">
                  {tool.id === 'burn-rate-calculator' && (
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-orange-500">
                      <path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z" />
                    </svg>
                  )}
                  {tool.id === 'runway-calculator' && (
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-blue-500">
                      <path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3.5c-.5-.5-2.5 0-4 1.5L13.5 8.5 5.3 6.7c-.9-.2-1.6.1-2 .5l-.8.8c-.4.4-.3 1.1.3 1.4L9 12.2l-3.3 3.3-3.1-1c-.5-.2-1.1 0-1.4.3l-.6.6c-.3.3-.3.9 0 1.2l3 3 3 3c.3.3.9.3 1.2 0l.6-.6c.3-.3.5-.9.3-1.4l-1-3.1 3.3-3.3 2.8 6.2c.3.6 1 .7 1.4.3l.8-.8c.4-.4.7-1.1.5-2z" />
                    </svg>
                  )}
                  {tool.id === 'exif-metadata-remover' && (
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-violet-500">
                      <path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"/>
                      <path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"/>
                      <path d="M6.61 6.61A13.52 13.52 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"/>
                      <line x1="2" y1="2" x2="22" y2="22"/>
                    </svg>
                  )}
                </div>
                <div class="flex items-center gap-2.5">
                  {tool.badge && (
                    <span class="px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 text-[10px] font-mono uppercase font-bold tracking-wider">
                      {tool.badge}
                    </span>
                  )}
                  <span class="font-mono text-xs font-semibold text-mute tracking-wider uppercase">
                    [ {tool.category} ]
                  </span>
                </div>
              </div>
              
              <h3 class="text-body-lg font-semibold text-ink mb-2 group-hover:text-link transition-colors">{tool.name}</h3>
              <p class="text-body text-sm leading-relaxed mb-4">{tool.description}</p>
              
              {/* Tool Mockup Preview */}
              {tool.id === 'burn-rate-calculator' && (
                <div class="mt-2 mb-6 bg-canvas-soft border border-hairline rounded-lg p-4 font-sans select-none relative overflow-hidden">
                  <div class="flex justify-between items-center mb-3">
                    <span class="text-[9px] font-mono font-semibold text-mute tracking-wider uppercase">Burndown Profile</span>
                    <span class="text-xs font-semibold text-orange-500 font-mono">-$24,500/mo</span>
                  </div>
                  <div class="flex items-end gap-1.5 h-16 w-full pt-2">
                    <div class="w-1/6 bg-orange-500/10 border border-orange-500/25 rounded-t h-[95%]"></div>
                    <div class="w-1/6 bg-orange-500/20 border border-orange-500/35 rounded-t h-[80%]"></div>
                    <div class="w-1/6 bg-orange-500/30 border border-orange-500/45 rounded-t h-[65%]"></div>
                    <div class="w-1/6 bg-orange-500/40 border border-orange-500/55 rounded-t h-[50%]"></div>
                    <div class="w-1/6 bg-orange-500/60 border border-orange-500/75 rounded-t h-[35%]"></div>
                    <div class="w-1/6 bg-orange-500 border border-orange-500 rounded-t h-[20%]"></div>
                  </div>
                  <div class="flex justify-between mt-1.5 text-[8px] text-mute font-mono uppercase tracking-wider">
                    <span>Month 1</span>
                    <span>Month 6 (Burnout)</span>
                  </div>
                </div>
              )}

              {tool.id === 'runway-calculator' && (
                <div class="mt-2 mb-6 bg-canvas-soft border border-hairline rounded-lg p-4 font-sans select-none relative overflow-hidden">
                  <div class="flex justify-between items-center mb-3">
                    <span class="text-[9px] font-mono font-semibold text-mute tracking-wider uppercase">Runway Metrics</span>
                    <span class="text-xs font-semibold text-emerald-500 font-mono uppercase tracking-wider">Healthy</span>
                  </div>
                  <div class="grid grid-cols-2 gap-2 mb-3">
                    <div class="p-2 bg-canvas border border-hairline rounded flex flex-col justify-center">
                      <span class="text-[8px] font-mono text-mute uppercase tracking-wider">Cash Reserve</span>
                      <span class="text-xs font-bold text-ink font-mono mt-0.5">$380,000</span>
                    </div>
                    <div class="p-2 bg-canvas border border-hairline rounded flex flex-col justify-center">
                      <span class="text-[8px] font-mono text-mute uppercase tracking-wider">Survival Limit</span>
                      <span class="text-xs font-bold text-ink font-mono mt-0.5">15.5 Months</span>
                    </div>
                  </div>
                  <div class="w-full bg-canvas-soft-2 border border-hairline h-2 rounded-full overflow-hidden">
                    <div class="h-full bg-emerald-500 rounded-full" style="width: 75%"></div>
                  </div>
                </div>
              )}

              {tool.id === 'exif-metadata-remover' && (
                <div class="mt-2 mb-6 bg-canvas-soft border border-hairline rounded-lg p-4 font-sans select-none relative overflow-hidden">
                  <div class="flex justify-between items-center mb-3">
                    <span class="text-[9px] font-mono font-semibold text-mute tracking-wider uppercase">Exif Stripper</span>
                    <span class="text-[9px] font-bold text-violet-500 font-mono uppercase tracking-wider">14 tags stripped</span>
                  </div>
                  <div class="p-2 bg-canvas border border-hairline rounded flex items-center gap-2.5">
                    <div class="w-8 h-8 rounded bg-canvas-soft border border-hairline flex items-center justify-center text-violet-500 shrink-0">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/>
                        <circle cx="12" cy="13" r="4"/>
                      </svg>
                    </div>
                    <div class="flex-grow min-w-0">
                      <div class="flex justify-between items-center">
                        <span class="text-[10px] font-semibold text-ink truncate block">sunset_sf.jpg</span>
                        <span class="text-[8px] font-mono text-mute shrink-0">4.2 MB</span>
                      </div>
                      <div class="flex gap-1 items-center mt-0.5">
                        <span class="w-1.5 h-1.5 rounded-full bg-success"></span>
                        <span class="text-[8px] text-success font-mono tracking-tight">GPS & Device Headers Cleaned</span>
                      </div>
                    </div>
                  </div>
                </div>
              )}
              
              <div class="mt-auto flex items-center text-sm font-semibold text-body group-hover:text-ink transition-colors">
                Open Tool 
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" class="ml-1.5 transform translate-x-0 group-hover:translate-x-1 transition-transform">
