---
import ToolLayout from '../../layouts/ToolLayout.astro';
import BurnRateCalculator from '../../components/tools/BurnRateCalculator.astro';
import RunwayCalculator from '../../components/tools/RunwayCalculator.astro';
import ExifMetadataRemover from '../../components/tools/ExifMetadataRemover.astro';
import ExifMetadataViewer from '../../components/tools/ExifMetadataViewer.astro';
import ExifMetadataViewerSeo from '../../components/tools/ExifMetadataViewerSeo.astro';
import { tools } from '../../data/tools';

export function getStaticPaths() {
  return tools.map(tool => ({
    params: { category: tool.category, tool: tool.id },
    props: { tool },
  }));
}

const { tool } = Astro.props;
---

<ToolLayout tool={tool}>
  {tool.id === 'burn-rate-calculator' && <BurnRateCalculator />}
  {tool.id === 'runway-calculator' && <RunwayCalculator />}
  {tool.id === 'exif-metadata-remover' && <ExifMetadataRemover />}
  {tool.id === 'exif-metadata-viewer' && <ExifMetadataViewer />}
  {tool.id === 'exif-metadata-viewer' && <ExifMetadataViewerSeo slot="seo" />}
</ToolLayout>
