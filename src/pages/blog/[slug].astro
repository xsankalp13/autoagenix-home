---
import { getCollection } from 'astro:content';
import BlogLayout from '../../layouts/BlogLayout.astro';
import ToolCard from '../../components/ToolCard.astro';
import { tools } from '../../data/tools';

export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');
  return blogEntries.map(entry => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

// Resolve related tools dynamically
const explicitToolSlugs = (entry.data.relatedTools || []).map((ref: any) => ref.id);
const relatedTools = tools.filter(t => 
  explicitToolSlugs.includes(t.id) || 
  entry.data.tags?.includes(t.category)
);
---

<BlogLayout 
  title={entry.data.title} 
  description={entry.data.description}
  date={entry.data.date instanceof Date ? entry.data.date.toISOString() : entry.data.date}
  author={entry.data.author}
>
  <Content />
  
  {relatedTools.length > 0 && (
    <div class="mt-16 pt-8 border-t border-hairline">
      <h3 class="text-display-xs font-semibold text-ink mb-6">Related Utilities</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {relatedTools.map(tool => (
          <ToolCard tool={tool} />
        ))}
      </div>
    </div>
  )}
</BlogLayout>
