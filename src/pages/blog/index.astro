---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { blogPosts } from '../../data/blog';
---

<BaseLayout title="Blog | AutoAgenix">
  <div class="max-w-3xl mx-auto px-4 py-24">
    <h1 class="text-display-xl font-semibold tracking-tight text-ink mb-12">Blog</h1>
    
    <div class="space-y-12">
      {blogPosts.map(post => (
        <article class="group">
          <time class="text-caption text-mute font-mono mb-2 block">
            {new Date(post.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
          <h2 class="text-display-md font-semibold text-ink mb-3 group-hover:text-link transition-colors">
            <a href={post.path}>{post.title}</a>
          </h2>
          <p class="text-body text-body-md mb-4">{post.description}</p>
          <a href={post.path} class="text-link text-body-sm font-medium hover:text-link-deep transition-colors">Read full article →</a>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>

