---
import BaseLayout from '../layouts/BaseLayout.astro';

// Format current date for the header
const lastUpdated = "June 11, 2026";
---

<BaseLayout title="Terms of Service | AutoAgenix" description="Review the AutoAgenix Terms of Service. Understand terms of use, licensing, and limitations of liability.">
  <div class="max-w-[1200px] mx-auto px-4 md:px-6 pt-24 pb-20">
    
    <!-- Header -->
    <header class="mb-16 pb-8 border-b border-hairline max-w-4xl animate-fade-up">
      <span class="font-mono text-xs uppercase tracking-widest text-mute mb-3 block">LEGAL / GUIDELINES</span>
      <h1 class="text-display-lg md:text-[56px] font-semibold tracking-[-2px] text-ink mb-4">Terms of Service.</h1>
      <p class="text-body-lg text-body">Last updated on {lastUpdated}</p>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">
      
      <!-- Sticky Sidebar Navigation (Desktop only) -->
      <aside class="lg:col-span-3 hidden lg:block sticky top-24 h-fit animate-fade-up delay-100">
        <span class="font-mono text-[10px] uppercase tracking-widest text-mute mb-4 block">ON THIS PAGE</span>
        <nav class="space-y-4 font-mono text-xs text-body">
          <a href="#acceptance" class="block hover:text-ink transition-colors font-medium">1. Acceptance of Terms</a>
          <a href="#license" class="block hover:text-ink transition-colors">2. Open License & Usage</a>
          <a href="#disclaimers" class="block hover:text-ink transition-colors">3. Output Disclaimers</a>
          <a href="#limitations" class="block hover:text-ink transition-colors">4. Liability Limitations</a>
          <a href="#governing-law" class="block hover:text-ink transition-colors">5. Revisions & Updates</a>
        </nav>
      </aside>

      <!-- Main Terms Content -->
      <div class="lg:col-span-9 max-w-3xl animate-fade-up delay-150">
        <div class="prose-custom">
          
          <p class="text-body-lg text-ink font-medium mb-12 leading-relaxed">
            By choosing to access and run calculations on AutoAgenix, you agree to comply with and be bound by the licensing terms detailed below. If you disagree with these guidelines, please suspend your use of our utilities.
          </p>

          <hr class="border-hairline my-8" />

          <!-- Section 1 -->
          <section id="acceptance" class="mb-12 scroll-mt-24">
            <h2 class="text-display-sm md:text-2xl font-semibold tracking-tight text-ink mb-4">1. Acceptance of Terms</h2>
            <p class="text-body text-sm leading-relaxed mb-4">
              AutoAgenix delivers browser-native web calculation tools. Access to our static domain, scripts, and utilities is governed by these Terms of Service. These conditions represent a legal arrangement between you and AutoAgenix.
            </p>
          </section>

          <!-- Section 2 -->
          <section id="license" class="mb-12 scroll-mt-24">
            <h2 class="text-display-sm md:text-2xl font-semibold tracking-tight text-ink mb-4">2. Open License & Usage</h2>
            <p class="text-body text-sm leading-relaxed mb-4">
              All tools, calculators, and assets built inside our platform are distributed under permissive open-source licenses. You are granted a non-exclusive, royalty-free license to use these tools for individual, corporate, or commercial calculation projects.
            </p>
            <p class="text-body text-sm leading-relaxed">
              You may not abuse our hosting bandwidth, scrape our static assets maliciously, or attempt to inject harmful scripts that compromise other users' client-side memory blocks.
            </p>
          </section>

          <!-- Section 3 -->
          <section id="disclaimers" class="mb-12 scroll-mt-24">
            <h2 class="text-display-sm md:text-2xl font-semibold tracking-tight text-ink mb-4">3. Output Disclaimers</h2>
            <p class="text-body text-sm leading-relaxed mb-4">
              The calculations, summaries, and information generated by the Burn Rate Calculator, Runway Calculator, and other utilities are computed dynamically based on the inputs you provide. They are offered purely for directional and informational guidelines.
            </p>
            <p class="text-body text-sm leading-relaxed">
              These outputs do not constitute professional accounting, financial investment, tax, or legal advice. AutoAgenix does not guarantee the accuracy of outputs for compliance reporting. Always cross-reference calculations with a certified professional.
            </p>
          </section>

          <!-- Section 4 -->
          <section id="limitations" class="mb-12 scroll-mt-24">
            <h2 class="text-display-sm md:text-2xl font-semibold tracking-tight text-ink mb-4">4. Liability Limitations</h2>
            <p class="text-body text-sm leading-relaxed mb-4">
              AutoAgenix utilities are provided on an "as is" and "as available" basis, without warranty of any kind, express or implied.
            </p>
            <p class="text-body text-sm leading-relaxed">
              Under no circumstances shall the creators, maintainers, or hosting providers of AutoAgenix be held liable for any loss of profit, loss of data, operational downtime, or direct/indirect damages arising from the use or inability to use our client-side software.
            </p>
          </section>

          <!-- Section 5 -->
          <section id="governing-law" class="mb-12 scroll-mt-24">
            <h2 class="text-display-sm md:text-2xl font-semibold tracking-tight text-ink mb-4">5. Revisions & Updates</h2>
            <p class="text-body text-sm leading-relaxed mb-4">
              We reserves the right to review and amend these Terms of Service periodically to adapt to new tool deployments or legislative revisions. Any updates will be pushed directly to this static page and will go into effect immediately.
            </p>
            <p class="text-body text-sm leading-relaxed">
              For any questions regarding these Terms, please reach out to our team at <a href="mailto:work@autoagenix.com" class="text-ink font-semibold hover:text-link underline">work@autoagenix.com</a>.
            </p>
          </section>

        </div>
      </div>

    </div>
  </div>
</BaseLayout>

<style>
  /* Smooth scroll support for side-jump navigation */
  html {
    scroll-behavior: smooth;
  }
</style>
