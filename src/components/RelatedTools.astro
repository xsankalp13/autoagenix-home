---
import ToolCard from './ToolCard.astro';
import type { Tool } from '../data/tools';

interface Props {
  tools: Tool[];
}

const { tools } = Astro.props;
---

<div>
  <h2 class="text-display-sm font-semibold text-ink mb-6">More from this category</h2>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    {tools.map(tool => (
      <ToolCard tool={tool} />
    ))}
  </div>
</div>
