---
---
<header
  id="site-header"
  class="fixed top-0 inset-x-0 z-50 transition-all duration-300"
>
  <div class="px-4 md:px-6 h-16 flex items-center justify-between max-w-[1400px] mx-auto">
    
    <!-- Left: Logo -->
    <div class="flex-1 flex justify-start">
      <a href="/" class="flex items-center gap-2.5 font-semibold tracking-tight text-ink hover:opacity-80 transition-opacity shrink-0" aria-label="AutoAgenix Home">
        <img src="/logo.png" alt="AutoAgenix Logo" width="32" height="32" class="w-8 h-8 object-contain shrink-0 logo-themed" />
        <span class="text-[15px]">AutoAgenix</span>
      </a>
    </div>
    
    <!-- Center: Nav Links -->
    <nav class="hidden md:flex items-center gap-1" aria-label="Primary navigation">
      <a href="/startup" class="nav-link px-3 py-1.5 rounded-full text-body text-sm hover:text-ink hover:bg-canvas-soft transition-all duration-150">Tools</a>
      <div class="relative group">
        <button class="nav-link px-3 py-1.5 rounded-full text-body text-sm hover:text-ink hover:bg-canvas-soft transition-all duration-150 flex items-center gap-1">
          Categories
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none" class="transition-transform group-hover:rotate-180">
            <path d="M2 4L6 8L10 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <!-- Dropdown -->
        <div class="absolute top-full left-1/2 -translate-x-1/2 mt-2 w-48 bg-canvas rounded-lg shadow-level-5 border border-hairline p-1 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-150 origin-top scale-95 group-hover:scale-100">
          <a href="/startup" class="flex items-center gap-2.5 px-3 py-2 rounded-md text-body text-sm hover:bg-canvas-soft hover:text-ink transition-colors">
            <span class="w-6 h-6 rounded flex items-center justify-center bg-canvas-soft-2 text-mute">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-orange">
                <path d="M4.5 16.5c-1.5 1.25-2.5 3.5-2.5 3.5s2.25-1 3.5-2.5L18.5 4.5c1.5-1.5 2-2 2-2s-.5.5-2 2L4.5 16.5z"/>
                <path d="m9 15 3 3"/>
                <path d="m15 9 3 3"/>
                <path d="M9 9c0 4.5 3 7.5 7.5 7.5"/>
              </svg>
            </span>
            Startup
          </a>
          <a href="/privacy" class="flex items-center gap-2.5 px-3 py-2 rounded-md text-body text-sm hover:bg-canvas-soft hover:text-ink transition-colors">
            <span class="w-6 h-6 rounded flex items-center justify-center bg-canvas-soft-2 text-mute">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-success">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
              </svg>
            </span>
            Privacy
          </a>
          <a href="/developer" class="flex items-center gap-2.5 px-3 py-2 rounded-md text-body text-sm hover:bg-canvas-soft hover:text-ink transition-colors">
            <span class="w-6 h-6 rounded flex items-center justify-center bg-canvas-soft-2 text-mute">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-link">
                <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
              </svg>
            </span>
            Developer
          </a>
        </div>
      </div>
      <a href="/blog" class="nav-link px-3 py-1.5 rounded-full text-body text-sm hover:text-ink hover:bg-canvas-soft transition-all duration-150">Blog</a>
    </nav>

    <!-- Right: Actions -->
    <div class="flex-1 flex items-center justify-end gap-2 shrink-0">
      <!-- Search -->
      <button
        id="search-btn"
        class="hidden sm:flex items-center gap-2 px-3 py-1.5 rounded-full text-mute text-sm border border-hairline hover:border-hairline-strong hover:text-ink transition-all duration-150 bg-canvas/50"
        aria-label="Search tools"
      >
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
          <circle cx="6" cy="6" r="4.5" stroke="currentColor" stroke-width="1.3"/>
          <path d="M9.5 9.5L12.5 12.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
        </svg>
        <span class="hidden md:inline">Search tools…</span>
        <kbd class="hidden lg:inline text-[10px] px-1.5 py-0.5 rounded bg-canvas-soft-2 font-mono text-mute border border-hairline">⌘K</kbd>
      </button>

      <!-- GitHub -->
      <a
        href="https://github.com/autoagenix"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden sm:flex items-center justify-center w-8 h-8 rounded-full text-body hover:text-ink hover:bg-canvas-soft transition-all duration-150 border border-transparent hover:border-hairline"
        aria-label="GitHub"
      >
        <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.17 6.839 9.49.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.603-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0112 6.836c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.202 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.165 22 16.418 22 12c0-5.523-4.477-10-10-10z"/>
        </svg>
      </a>

      <!-- Theme Toggle -->
      <button
        id="theme-toggle-btn"
        class="flex items-center justify-center w-8 h-8 rounded-full text-body hover:text-ink hover:bg-canvas-soft transition-all duration-150 border border-transparent hover:border-hairline"
        aria-label="Toggle theme"
      >
        <!-- Sun icon (shows in dark mode) -->
        <svg id="theme-icon-sun" class="hidden dark:block pointer-events-none" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2"></path>
          <path d="M12 20v2"></path>
          <path d="M4.93 4.93l1.41 1.41"></path>
          <path d="M17.66 17.66l1.41 1.41"></path>
          <path d="M2 12h2"></path>
          <path d="M20 12h2"></path>
          <path d="M6.34 17.66l-1.41 1.41"></path>
          <path d="M19.07 4.93l-1.41 1.41"></path>
        </svg>
        <!-- Moon icon (shows in light mode) -->
        <svg id="theme-icon-moon" class="block dark:hidden pointer-events-none" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
        </svg>
      </button>

      <!-- Get Started -->
      <a
        href="/startup"
        class="flex items-center px-3 py-1.5 bg-primary text-on-primary text-sm font-medium rounded-sm hover:bg-ink/90 transition-all duration-150 h-8"
      >
        Get Started
      </a>

      <!-- Mobile menu toggle -->
      <button
        id="mobile-menu-btn"
        class="md:hidden flex items-center justify-center w-8 h-8 rounded-full text-body hover:text-ink hover:bg-canvas-soft transition-colors"
        aria-label="Open menu"
        aria-expanded="false"
      >
        <svg id="menu-icon-open" width="18" height="18" viewBox="0 0 18 18" fill="none">
          <path d="M2 5h14M2 9h14M2 13h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
        <svg id="menu-icon-close" width="18" height="18" viewBox="0 0 18 18" fill="none" class="hidden">
          <path d="M4 4l10 10M14 4L4 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="hidden md:hidden border-t border-hairline bg-canvas/95 backdrop-blur-xl"
  >
    <nav class="max-w-[1400px] mx-auto px-4 py-4 flex flex-col gap-1">
      <a href="/startup" class="flex items-center gap-2.5 px-3 py-2.5 rounded-lg text-body text-sm hover:bg-canvas-soft hover:text-ink transition-colors font-medium">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-orange shrink-0">
          <path d="M4.5 16.5c-1.5 1.25-2.5 3.5-2.5 3.5s2.25-1 3.5-2.5L18.5 4.5c1.5-1.5 2-2 2-2s-.5.5-2 2L4.5 16.5z"/>
          <path d="m9 15 3 3"/>
          <path d="m15 9 3 3"/>
          <path d="M9 9c0 4.5 3 7.5 7.5 7.5"/>
        </svg>
        Startup Tools
      </a>
      <a href="/privacy" class="flex items-center gap-2.5 px-3 py-2.5 rounded-lg text-body text-sm hover:bg-canvas-soft hover:text-ink transition-colors font-medium">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-success shrink-0">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
        </svg>
        Privacy Tools
      </a>
      <a href="/developer" class="flex items-center gap-2.5 px-3 py-2.5 rounded-lg text-body text-sm hover:bg-canvas-soft hover:text-ink transition-colors font-medium">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-link shrink-0">
          <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
        </svg>
        Developer Tools
      </a>
      <a href="/blog" class="flex items-center gap-2.5 px-3 py-2.5 rounded-lg text-body text-sm hover:bg-canvas-soft hover:text-ink transition-colors font-medium">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-mute shrink-0">
          <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/>
          <polyline points="14 2 14 8 20 8"/>
          <line x1="16" y1="13" x2="8" y2="13"/>
          <line x1="16" y1="17" x2="8" y2="17"/>
          <line x1="10" y1="9" x2="8" y2="9"/>
        </svg>
        Blog
      </a>
      <div class="h-px bg-hairline my-2"></div>
      <a href="https://github.com/autoagenix" target="_blank" rel="noopener noreferrer" class="px-3 py-2.5 rounded-lg text-body text-sm hover:bg-canvas-soft hover:text-ink transition-colors font-medium">⭐ GitHub</a>
    </nav>
  </div>
</header>

<script>
  // Glassmorphic on scroll
  const header = document.getElementById('site-header');
  let lastScroll = 0;

  const updateHeader = () => {
    const scrollY = window.scrollY;
    if (scrollY > 10) {
      header?.classList.add('header-scrolled');
    } else {
      header?.classList.remove('header-scrolled');
    }
    lastScroll = scrollY;
  };

  window.addEventListener('scroll', updateHeader, { passive: true });
  updateHeader();

  // Theme Toggle Button click handler
  const themeToggleBtn = document.getElementById('theme-toggle-btn');
  themeToggleBtn?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
    window.dispatchEvent(new CustomEvent('theme-changed', { detail: { theme: isDark ? 'dark' : 'light' } }));
  });

  // Search button action
  const searchBtn = document.getElementById('search-btn');
  searchBtn?.addEventListener('click', () => {
    const searchInput = document.getElementById('tool-search') as HTMLInputElement;
    if (searchInput) {
      document.getElementById('search-tools')?.scrollIntoView({ behavior: 'smooth' });
      setTimeout(() => searchInput.focus(), 300);
    } else {
      window.location.href = '/#search-tools';
    }
  });

  // Mobile menu
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuIconOpen = document.getElementById('menu-icon-open');
  const menuIconClose = document.getElementById('menu-icon-close');

  mobileMenuBtn?.addEventListener('click', () => {
    const isOpen = !mobileMenu?.classList.contains('hidden');
    if (isOpen) {
      mobileMenu?.classList.add('hidden');
      menuIconOpen?.classList.remove('hidden');
      menuIconClose?.classList.add('hidden');
      mobileMenuBtn.setAttribute('aria-expanded', 'false');
    } else {
      mobileMenu?.classList.remove('hidden');
      menuIconOpen?.classList.add('hidden');
      menuIconClose?.classList.remove('hidden');
      mobileMenuBtn.setAttribute('aria-expanded', 'true');
    }
  });
</script>

<style>
  #site-header {
    background: transparent;
  }

  #site-header.header-scrolled {
    background: var(--header-bg-scrolled);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--header-border-scrolled);
  }

  .logo-themed {
    filter: invert(1) hue-rotate(180deg);
    mix-blend-mode: multiply;
  }

  :global(.dark) .logo-themed {
    filter: none;
    mix-blend-mode: screen;
  }
</style>
