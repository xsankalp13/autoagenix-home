---
import type { SchemaOrgEntity } from '../../lib/seo/schema';

interface Props {
  schema: SchemaOrgEntity | SchemaOrgEntity[];
}

const { schema } = Astro.props;
const schemas = Array.isArray(schema) ? schema : [schema];
---

{schemas.map((s) => (
  <script
    type="application/ld+json"
    set:html={JSON.stringify(s)}
  />
))}
