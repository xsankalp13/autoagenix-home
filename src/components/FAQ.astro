---
interface Props {
  faqs: { question: string; answer: string }[];
}

const { faqs } = Astro.props;
---

<div class="space-y-4">
  {faqs.map(faq => (
    <details class="group bg-canvas border border-hairline rounded-md shadow-level-1 [&_summary::-webkit-details-marker]:hidden">
      <summary class="flex items-center justify-between p-4 cursor-pointer font-medium text-ink">
        <span>{faq.question}</span>
        <span class="transition group-open:rotate-180">
          <svg fill="none" height="24" shape-rendering="geometricPrecision" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
        </span>
      </summary>
      <div class="p-4 pt-0 text-body text-body-sm leading-relaxed">
        {faq.answer}
      </div>
    </details>
  ))}
</div>
