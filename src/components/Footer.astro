---
---
<footer class="bg-canvas border-t border-hairline">
  <!-- Main footer content -->
  <div class="max-w-[1400px] mx-auto px-4 md:px-6 pt-20 pb-16">
    <div class="grid grid-cols-1 md:grid-cols-6 gap-10 lg:gap-16">

      <!-- Brand & Mission column -->
      <div class="md:col-span-2">
        <a href="/" class="flex items-center gap-2.5 font-semibold tracking-tight text-ink hover:opacity-80 transition-opacity mb-5" aria-label="AutoAgenix">
          <img src="/logo.png" alt="AutoAgenix Logo" width="32" height="32" class="w-8 h-8 object-contain shrink-0 logo-themed" />
          <span class="text-[15px]">AutoAgenix</span>
        </a>
        <p class="text-body text-sm leading-relaxed max-w-sm mb-6">
          AutoAgenix builds privacy-first browser tools that help professionals work faster without sacrificing security.
        </p>
        <!-- Social links -->
        <div class="flex items-center gap-3">
          <a
            href="https://github.com/autoagenix"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-center w-8 h-8 rounded-full text-body hover:text-ink hover:bg-canvas-soft transition-all duration-150 border border-transparent hover:border-hairline"
            aria-label="GitHub"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.17 6.839 9.49.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.603-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0112 6.836c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.202 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.165 22 16.418 22 12c0-5.523-4.477-10-10-10z"/>
            </svg>
          </a>
          <a
            href="https://twitter.com/autoagenix"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-center w-8 h-8 rounded-full text-body hover:text-ink hover:bg-canvas-soft transition-all duration-150 border border-transparent hover:border-hairline"
            aria-label="Twitter"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Categories column -->
      <div>
        <h3 class="font-mono text-xs font-semibold tracking-wider uppercase text-mute mb-4">[ Categories ]</h3>
        <ul class="space-y-3">
          <li><a href="/startup" class="text-body text-sm hover:text-ink transition-colors">Startup Tools</a></li>
          <li><a href="/privacy" class="text-body text-sm hover:text-ink transition-colors">Privacy Tools</a></li>
          <li><span class="text-mute text-sm font-mono">[ Developer ]</span></li>
          <li><span class="text-mute text-sm font-mono">[ Creator ]</span></li>
        </ul>
      </div>

      <!-- Featured Tools column -->
      <div>
        <h3 class="font-mono text-xs font-semibold tracking-wider uppercase text-mute mb-4">[ Featured ]</h3>
        <ul class="space-y-3">
          <li><a href="/startup/burn-rate-calculator" class="text-body text-sm hover:text-ink transition-colors">Burn Rate Calculator</a></li>
          <li><a href="/startup/runway-calculator" class="text-body text-sm hover:text-ink transition-colors">Runway Calculator</a></li>
          <li><a href="/privacy/exif-metadata-remover" class="text-body text-sm hover:text-ink transition-colors">EXIF Metadata Remover</a></li>
        </ul>
      </div>

      <!-- Resources/Company column -->
      <div>
        <h3 class="font-mono text-xs font-semibold tracking-wider uppercase text-mute mb-4">[ Company ]</h3>
        <ul class="space-y-3">
          <li><a href="/about" class="text-body text-sm hover:text-ink transition-colors">About Us</a></li>
          <li><a href="/contact" class="text-body text-sm hover:text-ink transition-colors">Contact</a></li>
          <li><a href="/blog" class="text-body text-sm hover:text-ink transition-colors">Blog</a></li>
        </ul>
      </div>

      <!-- Legal column -->
      <div>
        <h3 class="font-mono text-xs font-semibold tracking-wider uppercase text-mute mb-4">[ Legal ]</h3>
        <ul class="space-y-3">
          <li><a href="/privacy-policy" class="text-body text-sm hover:text-ink transition-colors">Privacy Policy</a></li>
          <li><a href="/terms" class="text-body text-sm hover:text-ink transition-colors">Terms of Service</a></li>
          <li><a href="/llms.txt" class="text-body text-sm hover:text-ink transition-colors font-mono text-xs">llms.txt</a></li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="border-t border-hairline">
    <div class="max-w-[1400px] mx-auto px-4 md:px-6 py-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-mute text-xs font-mono">
        &copy; {new Date().getFullYear()} AutoAgenix. All rights reserved.
      </p>
      <p class="text-mute text-xs text-center sm:text-right max-w-xs">
        Built for privacy. Your data stays on your device — always.
      </p>
    </div>
  </div>
</footer>

<style>
  .logo-themed {
    filter: invert(1) hue-rotate(180deg);
    mix-blend-mode: multiply;
  }

  :global(.dark) .logo-themed {
    filter: none;
    mix-blend-mode: screen;
  }
</style>
